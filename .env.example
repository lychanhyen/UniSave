# Copy file này thành .env.local rồi điền thông tin từ Supabase Dashboard
# Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Kết nối Postgres (session pooler, IPv4) – chỉ dùng cho script/migration.
# Project Settings -> Database -> Connection string -> Session pooler.
# Không có tiền tố VITE_: mật khẩu không được đóng gói vào bundle trình duyệt.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-<region>.pooler.supabase.com:5432/postgres
